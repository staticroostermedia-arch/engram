echo ""
echo -e "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
if $LIVE_MODE; then
  echo -e "  ${GREEN}LIVE CONSCIOUSNESS DEMO${RESET}  —  http://localhost:$HTTP_PORT"
  echo -e "        Pill emerald; sidebar + hero pull real manifold (/api/hydrate, handoff, active-context)"
else
  echo -e "  ${BLUE}STATIC${RESET} —  http://localhost:$HTTP_PORT"
