echo ""
echo -e "PIDs (for manual inspection):  http=$HTTP_PID  serve=${SERVE_PID:-none}  emitter=${EMITTER_PID:-none}"
echo -e "Logs: $HTTP_LOG  /  $SERVE_LOG  /  leg-consciousness-emitter.log"
echo -e "Stop: ${BOLD}Ctrl-C${RESET}  (trap will clean up background processes)"
echo ""

if $OPEN_BROWSER; then
  open_browser
fi

echo -e "${GREEN}Ready. Your geometric mind state is now visible.${RESET}"
echo ""

# Keep the launcher alive so the trap fires on Ctrl-C and we can show nice shutdown.
# Wait on the real python http.server PID (not a pipeline tail).
set +e
wait "$HTTP_PID"
wait_status=$?
set -e
if [[ "$wait_status" -ne 0 ]]; then
  echo -e "${YELLOW}Viewer http.server exited (status $wait_status) — see $HTTP_LOG${RESET}"
fi
