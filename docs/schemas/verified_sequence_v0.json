{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.dev/schemas/verified_sequence_v0.json",
  "title": "verified_sequence_v0",
  "type": "object",
  "required": ["version", "steps"],
  "properties": {
    "version": { "const": "verified_sequence_v0" },
    "goal_context": { "type": "string" },
    "source_traces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision", "why"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "trace_id": { "type": "string" },
          "decision": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "tool_hints": {
            "type": "array",
            "items": { "type": "string" },
            "description": "JIT MCP tool suggestions inferred from trace spatial_context + decision semantics"
          },
          "spatial_context": {
            "type": "string",
            "description": "Copied from source trace (e.g. store.rs:706) — agent resolves absolute path at replay"
          },
          "goal_context": { "type": "string" },
          "args_hints": {
            "type": "object",
            "description": "Per-tool arg templates keyed by MCP tool name (construct absolute paths at replay)",
            "additionalProperties": { "type": "object" }
          },
          "alternatives": { "type": "string" },
          "falsifiability": { "type": "string" },
          "outcome": { "type": "string" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "replay_contract": { "type": "string" }
  }
}